---
# kubernetes/clusters/kclt-01/bootstrap/ksops-agekey.sops.yaml.example
#
# This file is a template/stub. To use:
#   1. Copy to ksops-agekey.sops.yaml (gitignored as plaintext)
#   2. Replace <YOUR_AGE_PRIVATE_KEY> with the actual private key
#   3. Encrypt: task encrypt FILE=kubernetes/clusters/kclt-01/bootstrap/ksops-agekey.sops.yaml
#   4. Uncomment the resource entry in kustomization.yaml
#
# The 'ksops-age-key' secret is mounted by the argocd-repo-server
# container to decrypt app secrets at sync time.
# See: argocd/install/kustomization.yaml (volumeMount: /var/run/secrets/age/)
apiVersion: v1
kind: Secret
metadata:
  name: ksops-age-key
  namespace: argocd
type: Opaque
stringData:
  # Age private key for kclt-01 cluster
  # Public key: age1spkux7hcrspxgl3xq8x7chykdr2d47q5l0jtucqu4gpkvre2cdfsgf38dz
  key.txt: |
    # created: <date>
    # public key: age1spkux7hcrspxgl3xq8x7chykdr2d47q5l0jtucqu4gpkvre2cdfsgf38dz
    AGE-SECRET-KEY-<YOUR_AGE_PRIVATE_KEY>
