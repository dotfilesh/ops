{
    "packageRules": [
        {
            "groupName": "flux-operator",
            "description": "Flux Operator and FluxInstance charts ship together",
            "matchPackageNames": ["/flux-operator/", "/flux-instance/"],
            "matchDatasources": ["docker"],
            "group": { "commitMessageTopic": "{{{groupName}}} group" }
        },
        {
            "groupName": "cert-manager",
            "description": "Cert-Manager image (for CRDs) and chart",
            "matchPackageNames": ["/cert-manager/"],
            "matchDatasources": ["docker", "helm"],
            "group": { "commitMessageTopic": "{{{groupName}}} group" },
            "separateMinorPatch": true
        },
        {
            "groupName": "rook-ceph",
            "description": "Rook-Ceph image, CRDs, and chart",
            "matchPackageNames": ["/rook-ceph/"],
            "matchDatasources": ["docker", "github-tags", "helm"],
            "group": { "commitMessageTopic": "{{{groupName}}} group" },
            "separateMinorPatch": true
        },
    ]
}
